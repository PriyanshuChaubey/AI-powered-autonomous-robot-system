      "role": "forward distance"
    },
    {
      "ref": "U4",
      "part": "IR obstacle module (left)",
      "role": "left edge"
    },
    {
      "ref": "U5",
      "part": "IR obstacle module (right)",
      "role": "right edge"
    },
    {

      "gpio": 2,
      "direction": "output",
      "connected_to": "D1 anode",
      "note": "on-board LED, strapping pin"
    }
  ],
  "power": {
    "motor_supply": "2x18650 (7.4 V nominal) into L298N VIN; L298N 5 V out feeds the ESP32 VIN",
    "servo_supply": "L298N 5 V rail, with a 470 uF capacitor across the servo terminals",
    "common_ground": true,
    "estimated_current_ma": {
      "idle": 120,
      "both_motors": 900,
      "peak": 1800
    }
  },
  "state_machine": {
    "initial": "FORWARD",
    "states": [
      {
        "name": "FORWARD",
        "entry": "both motors forward at CRUISE_DUTY"
      },
      {
        "name": "STOPPED",
        "entry": "both motors off; brake for TURN_MS"
      },
      {
        "name": "TURNING",
        "entry": "left motor reverse, right motor forward for TURN_MS"
      }
    ],
    "transitions": [
      {
        "from": "FORWARD",
        "to": "STOPPED",
        "when": "distance_cm < STOP_DISTANCE_CM"
      },
      {
        "from": "FORWARD",
        "to": "TURNING",
        "when": "IR_LEFT is blocked and IR_RIGHT is clear"
      },
      {
        "from": "STOPPED",
        "to": "TURNING",
        "when": "TURN_MS has elapsed"
      },
      {
        "from": "TURNING",
        "to": "FORWARD",
        "when": "TURN_MS has elapsed and the path is clear"
      }
    ]
  },
  "timing": {
    "loop_hz": 50,
    "loop_period_ms": 20,
    "sonar_period_ms": 60,
    "turn_ms": 450,
    "telemetry_baud": 115200
  },
  "constants": {
    "STOP_DISTANCE_CM": 20,
    "CLEAR_DISTANCE_CM": 30,
    "CRUISE_DUTY": 180,
    "TURN_DUTY": 200,
    "PWM_FREQ_HZ": 1000,
    "PWM_RESOLUTION_BITS": 8
  },
  "modules": [
    {
      "name": "motors",
      "responsibility": "direction and speed control, forward/stop/turn primitives"
    },
    {
      "name": "sonar",
      "responsibility": "non-blocking HC-SR04 pulse and echo measurement"
    },
    {
      "name": "sensing",
      "responsibility": "IR edge flags"
    },
    {
      "name": "control",
      "responsibility": "the FORWARD/STOPPED/TURNING state machine"
    },
    {
      "name": "telemetry",
      "responsibility": "one JSON line per cycle"
    },
    {
      "name": "status",
      "responsibility": "LED blink pattern per state"
    }
  ],
  "safety": "stop() is called on every transition into STOPPED and in setup() before the motors are ever energised. A distance reading of 0 cm or a timeout on the echo pulse is treated as an obstacle, so a failed sensor fails safe rather than driving blind.",
